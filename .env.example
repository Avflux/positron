# Copie para .env e ajuste. O Rust repassa estas variáveis ao sidecar.
#
# Prefixo de todas: SIDECAR_ (ver services/sidecar/src/sidecar/config.py).
# Deixe a variável COMENTADA para usar o padrão do código — evite `VAR=` vazio,
# porque o pydantic-settings tentaria interpretar string vazia.

# Bind do ROUTER e do PUB. Sempre loopback: o sidecar não fala com a rede.
SIDECAR_ZMQ_HOST=127.0.0.1

# Porta do ROUTER. 0 = o SO escolhe; o Rust lê a porta pelo handshake de stdout.
SIDECAR_ZMQ_PORT=0

# FastAPI (modo dev:web, health-check e Swagger).
SIDECAR_HTTP_ENABLED=true
SIDECAR_HTTP_PORT=8765

SIDECAR_LOG_LEVEL=INFO

# Intervalo do evento `heartbeat` em segundos. 0 desliga.
SIDECAR_HEARTBEAT_SECONDS=15

# --- Frontend (lidas pelo Vite, não pelo Python) ---
# Base do FastAPI usada quando a UI roda no navegador, sem Tauri.
VITE_HTTP_BASE=http://127.0.0.1:8765
