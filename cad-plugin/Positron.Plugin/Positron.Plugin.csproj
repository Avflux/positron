<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Positron.Plugin</RootNamespace>
    <!-- Plataforma alvo: ZWCAD (padrão) ou AutoCAD -->
    <CadPlatform Condition="'$(CadPlatform)' == ''">ZWCAD</CadPlatform>
    <DefineConstants Condition="'$(CadPlatform)' == 'AutoCAD'">AUTOCAD;$(DefineConstants)</DefineConstants>
    <DefineConstants Condition="'$(CadPlatform)' == 'ZWCAD'">ZWCAD;$(DefineConstants)</DefineConstants>
    <AssemblyName Condition="'$(CadPlatform)' == 'AutoCAD'">Positron.Plugin.AutoCAD</AssemblyName>
    <AssemblyName Condition="'$(CadPlatform)' == 'ZWCAD'">Positron.Plugin.ZWCAD</AssemblyName>
    <OutputPath>bin\$(Configuration)\$(CadPlatform)\</OutputPath>
  </PropertyGroup>

  <!--
    CONFIGURAÇÃO AUTOCAD
    Se `AutoCadDir` for fornecido ou detectado na máquina, referencia as DLLs reais do AutoCAD:
        dotnet build -p:CadPlatform=AutoCAD -p:AutoCadDir="C:\Program Files\Autodesk\AutoCAD 2024"
    Caso contrário, compila com o stub Positron.CadStub como gate de compilação.
  -->
  <PropertyGroup Condition="'$(CadPlatform)' == 'AutoCAD'">
    <AutoCadDir Condition="'$(AutoCadDir)' == '' And Exists('$(MSBuildThisFileDirectory)..\lib\AutoCAD\2020\accoremgd.dll')">$(MSBuildThisFileDirectory)..\lib\AutoCAD\2020</AutoCadDir>
    <AutoCadDir Condition="'$(AutoCadDir)' == '' And Exists('$(ProgramFiles)\Autodesk\AutoCAD 2026')">$(ProgramFiles)\Autodesk\AutoCAD 2026</AutoCadDir>
    <AutoCadDir Condition="'$(AutoCadDir)' == '' And Exists('$(ProgramFiles)\Autodesk\AutoCAD 2025')">$(ProgramFiles)\Autodesk\AutoCAD 2025</AutoCadDir>
    <AutoCadDir Condition="'$(AutoCadDir)' == '' And Exists('$(ProgramFiles)\Autodesk\AutoCAD 2024')">$(ProgramFiles)\Autodesk\AutoCAD 2024</AutoCadDir>
    <AutoCadDir Condition="'$(AutoCadDir)' == '' And Exists('$(ProgramFiles)\Autodesk\AutoCAD 2023')">$(ProgramFiles)\Autodesk\AutoCAD 2023</AutoCadDir>
    <AutoCadDir Condition="'$(AutoCadDir)' == '' And Exists('$(ProgramFiles)\Autodesk\AutoCAD 2022')">$(ProgramFiles)\Autodesk\AutoCAD 2022</AutoCadDir>
    <AutoCadDir Condition="'$(AutoCadDir)' == '' And Exists('$(ProgramFiles)\Autodesk\AutoCAD 2021')">$(ProgramFiles)\Autodesk\AutoCAD 2021</AutoCadDir>
    <AutoCadDir Condition="'$(AutoCadDir)' == '' And Exists('$(ProgramFiles)\Autodesk\AutoCAD 2020')">$(ProgramFiles)\Autodesk\AutoCAD 2020</AutoCadDir>
  </PropertyGroup>

  <!-- Os icones do produto original (extraidos pelo scripts/extrair-icones-do-reverso.ps1)
       entram como recursos embutidos: a barra os le pelo nome (Positron.Icons.<nome>.png). -->
  <ItemGroup>
    <EmbeddedResource Include="..\lib\Icons\*.png">
      <LogicalName>Positron.Icons.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- A interface (a paleta de folhas e a barra de ferramentas) usa WinForms e, no ZWCAD, o
       ZdWindows (ZwSoft.Windows = ribbon, ZwSoft.ZwCAD.Windows = paleta). -->
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Xaml" />
  </ItemGroup>


  <ItemGroup Condition="'$(CadPlatform)' == 'AutoCAD' And '$(AutoCadDir)' != ''">
    <Reference Include="accoremgd">
      <HintPath>$(AutoCadDir)\accoremgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acmgd">
      <HintPath>$(AutoCadDir)\acmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acdbmgd">
      <HintPath>$(AutoCadDir)\acdbmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- A interface do AutoCAD: o Autodesk.Windows (RibbonControl e itens) vive na AdWindows.dll,
         a irma da ZdWindows do ZWCAD. Entra no build AutoCAD desde a rodada 138 (a barra). -->
    <Reference Include="AdWindows">
      <HintPath>$(AutoCadDir)\AdWindows.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(CadPlatform)' == 'AutoCAD' And '$(AutoCadDir)' == ''">
    <ProjectReference Include="..\Positron.CadStub\Positron.CadStub.csproj" />
  </ItemGroup>

  <!--
    CONFIGURAÇÃO ZWCAD
    Com `ZWCadDir` definido ou detectado, o plugin é gerado contra a API gerenciada REAL:
        dotnet build -p:CadPlatform=ZWCAD -p:ZWCadDir="C:\Program Files\ZWSOFT\ZWCAD 2026"
    Sem ele, compila contra o stub (Positron.CadStub) para gate de compilação.
  -->
  <PropertyGroup Condition="'$(CadPlatform)' == 'ZWCAD'">
    <ZWCadDir Condition="'$(ZWCadDir)' == '' And Exists('$(MSBuildThisFileDirectory)..\lib\ZWCAD\2026\ZwManaged.dll')">$(MSBuildThisFileDirectory)..\lib\ZWCAD\2026</ZWCadDir>
    <ZWCadDir Condition="'$(ZWCadDir)' == '' And Exists('$(ProgramFiles)\ZWSOFT\ZWCAD 2026')">$(ProgramFiles)\ZWSOFT\ZWCAD 2026</ZWCadDir>
    <ZWCadDir Condition="'$(ZWCadDir)' == '' And Exists('$(ProgramFiles)\ZWSOFT\ZWCAD 2025')">$(ProgramFiles)\ZWSOFT\ZWCAD 2025</ZWCadDir>
  </PropertyGroup>

  <ItemGroup Condition="'$(CadPlatform)' == 'ZWCAD' And '$(ZWCadDir)' != ''">
    <Reference Include="ZwManaged">
      <HintPath>$(ZWCadDir)\ZwManaged.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ZwDatabaseMgd">
      <HintPath>$(ZWCadDir)\ZwDatabaseMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- A API de interface do ZWCAD: ZwSoft.Windows (ribbon) e ZwSoft.ZwCAD.Windows (paleta). -->
    <Reference Include="ZdWindows">
      <HintPath>$(ZWCadDir)\ZdWindows.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(CadPlatform)' == 'ZWCAD' And '$(ZWCadDir)' == ''">
    <ProjectReference Include="..\Positron.CadStub\Positron.CadStub.csproj" />
  </ItemGroup>

  <!--
    O Excel ATIVO da tela frmEditaTitulos (o `clsTextos.ExportaPaginas`/`ImportaTitulos` do reverso)
    fala com a instancia aberta do Excel pela PIA `Microsoft.Office.Interop.Excel` — a MESMA que o
    original usa. A copia fica versionada em `lib\Excel` (scripts/prepare-excel-api.ps1, o padrao das
    outras APIs vendorizadas); sem ela, e preciso a PIA do Office instalado (GAC).
    `<EmbedInteropTypes>` embute os tipos usados: em tempo de execucao nao e preciso a PIA ao lado da
    DLL (e o que o original tambem faz).
  -->
  <PropertyGroup>
    <ExcelApiDir Condition="'$(ExcelApiDir)' == '' And Exists('$(MSBuildThisFileDirectory)..\lib\Excel\Microsoft.Office.Interop.Excel.dll')">$(MSBuildThisFileDirectory)..\lib\Excel</ExcelApiDir>
  </PropertyGroup>

  <ItemGroup Condition="'$(ExcelApiDir)' != ''">
    <Reference Include="Microsoft.Office.Interop.Excel">
      <HintPath>$(ExcelApiDir)\Microsoft.Office.Interop.Excel.dll</HintPath>
      <EmbedInteropTypes>true</EmbedInteropTypes>
      <Private>false</Private>
    </Reference>
    <!-- Com os tipos de interoperabilidade embutidos, ler uma propriedade `object` do Excel (o
         `Range.Value`, por exemplo) exige o binder dinamico do compilador. -->
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Positron.Data\Positron.Data.csproj" />
  </ItemGroup>

  <!-- A tela de configuracao (comando ELETCFG) usa WinForms, como as frm* do original. -->
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

</Project>
