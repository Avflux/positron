{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pósitron",
  "version": "0.1.0",
  "identifier": "com.example.positron",
  "build": {
    "beforeBuildCommand": "npm run build --workspace @app/web",
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173"
  },
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pósitron",
        "width": 1000,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "visible": false, "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}

