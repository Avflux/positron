{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZMQ Starter",
  "version": "0.1.0",
  "identifier": "com.example.zmqstarter",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ZMQ Starter",
        "width": 1000,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/sidecar"
    ]
  }
}
