root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.rs]
indent_size = 4

# ATENÇÃO: salve os .ps1 como UTF-8 **com BOM**. O PowerShell 5.1 lê arquivo sem
# BOM como ANSI, o que transforma os acentos em lixo e quebra o parser com um erro
# que nem aponta para o lugar certo. (O editorconfig não sabe expressar BOM.)
# Ver docs/RUNBOOK.md.
[*.ps1]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
