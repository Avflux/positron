<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Positron.Plugin</RootNamespace>
    <AssemblyName>Positron.Plugin</AssemblyName>
  </PropertyGroup>

  <!--
    Com `ZWCadDir` definido, o plugin é gerado contra a API gerenciada REAL e
    fica carregável por NETLOAD:

        dotnet build -p:ZWCadDir="C:\Program Files\ZWSOFT\ZWCAD 2026"

    Sem ele, compila contra o stub de compilação (Positron.ZwcadStub) e serve
    apenas de gate — o resultado NÃO carrega dentro do ZWCAD. Tentamos adivinhar
    um caminho comum antes de cair no stub.
  -->
  <PropertyGroup>
    <ZWCadDir Condition="'$(ZWCadDir)' == '' And Exists('$(ProgramFiles)\ZWSOFT\ZWCAD 2026')">$(ProgramFiles)\ZWSOFT\ZWCAD 2026</ZWCadDir>
  </PropertyGroup>

  <ItemGroup Condition="'$(ZWCadDir)' != ''">
    <Reference Include="ZwManaged">
      <HintPath>$(ZWCadDir)\ZwManaged.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ZwDatabaseMgd">
      <HintPath>$(ZWCadDir)\ZwDatabaseMgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(ZWCadDir)' == ''">
    <ProjectReference Include="..\Positron.ZwcadStub\Positron.ZwcadStub.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Positron.Data\Positron.Data.csproj" />
  </ItemGroup>

</Project>
