{
  "name": "positron",
  "private": true,
  "version": "0.1.0",
  "description": "Desktop app scaffold: Tauri shell + Vite/React UI + Python ZMQ sidecar",
  "workspaces": [
    "apps/web",
    "apps/desktop",
    "packages/protocol"
  ],
  "scripts": {
    "_comment_dev": "--- DESENVOLVIMENTO: faz bootstrap completo e sobe o app ---",
    "dev": "node scripts/dev.mjs",
    "dev:parallel": "concurrently -k -n web,tauri -c cyan,magenta \"npm:dev:web\" \"npm:dev:desktop\"",
    "dev:web": "npm run dev --workspace @app/web",
    "dev:desktop": "node scripts/check-python.mjs && npm run dev --workspace @app/desktop",
    "_comment_build": "--- PRODUÇÃO: apenas compila, sem subir o app ---",
    "build:web": "npm run build --workspace @app/web",
    "build:desktop": "npm run sidecar:build && npm run build --workspace @app/desktop",
    "build:all": "npm run protocol:gen && npm run build:web && npm run build:desktop",
    "_comment_utils": "--- UTILITÁRIOS ---",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:sidecar": "node scripts/check-python.mjs && uv run --directory services/sidecar pytest -q",
    "sidecar:sync": "node scripts/check-python.mjs && uv sync --directory services/sidecar --group dev",
    "sidecar:run": "node scripts/check-python.mjs && uv run --directory services/sidecar python -m sidecar",
    "sidecar:build": "powershell -ExecutionPolicy Bypass -File scripts/build-sidecar.ps1",
    "protocol:gen": "node scripts/gen-protocol.mjs && node scripts/gen-schema.mjs",
    "schema:sync": "node scripts/gen-schema.mjs --write",
    "plugin:build": "npm run plugin:build:zwcad",
    "plugin:build:zwcad": "node scripts/run-dotnet.mjs build cad-plugin/Positron.Plugin/Positron.Plugin.csproj -p:CadPlatform=ZWCAD",
    "plugin:build:autocad": "node scripts/run-dotnet.mjs build cad-plugin/Positron.Plugin/Positron.Plugin.csproj -p:CadPlatform=AutoCAD",
    "plugin:build:all": "npm run plugin:build:zwcad && npm run plugin:build:autocad",
    "plugin:test": "node scripts/run-dotnet.mjs test cad-plugin/Positron.Data.Tests/Positron.Data.Tests.csproj",
    "cad:smoke": "powershell -ExecutionPolicy Bypass -File scripts/cad-zwcad-smoke.ps1",
    "cad:e2e": "powershell -ExecutionPolicy Bypass -File scripts/cad-zwcad-smoke.ps1 -Fixture scripts/cad-fixture.lsp -Comandos ELET,FIA,INT,SYNCD,VERIF",
    "cad:smoke:acad": "powershell -ExecutionPolicy Bypass -File scripts/cad-autocad-smoke.ps1",
    "cad:e2e:acad": "powershell -ExecutionPolicy Bypass -File scripts/cad-autocad-smoke.ps1 -Fixture scripts/cad-fixture.lsp -Comandos ELET,FIA,INT,SYNCD,VERIF",
    "cad:projeto": "powershell -ExecutionPolicy Bypass -File scripts/cad-projeto-e2e.ps1",
    "cad:projeto:acad": "powershell -ExecutionPolicy Bypass -File scripts/cad-projeto-e2e.ps1 -Cad AutoCAD"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
