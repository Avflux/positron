; Rodada 183: roda em COPIA do Funcional.dwg. TextString difere do XData;
; mais de quatro entidades titulo e indice 9 provam o AtualizaTitulos da grade.
(regapp "DiagLog")
(defun pz-titulos:novo (indice texto /)
  (entmakex (list '(0 . "TEXT") '(8 . "2") '(10 950000.0 0.0 0.0) '(40 . 2.5)
    (cons 1 texto)
    (list -3 (list "DiagLog" '(1000 . "TituloPagina") (cons 1070 indice)
      '(1000 . "XDATA ANTIGO") '(1070 . 1) '(1000 . "harness") '(1000 . "183")
      '(1071 . 1) '(1040 . 1.0) '(1000 . " "))))))
(if (= (getenv "POSITRON_TITULOS_MONTAR") "1")
  (progn
    (repeat 5 (pz-titulos:novo 1 "TEXTO VISIVEL 183"))
    (pz-titulos:novo 9 "ALTERNATIVO ANTIGO")))
(defun pz-titulos:dump (/ ss i e d x f)
  (setq f (open (getenv "POSITRON_TITULOS_SAIDA") "w")
        ss (ssget "_X" '((0 . "TEXT") (8 . "2"))) i 0)
  (while (and ss (< i (sslength ss)))
    (setq e (ssname ss i) i (1+ i) d (entget e '("DiagLog"))
          x (cdr (assoc "DiagLog" (cdr (assoc -3 d)))))
    (if (and x (= (cdr (car x)) "TituloPagina"))
      (write-line (strcat "TITULO;" (itoa (cdr (cadr x))) ";texto=" (cdr (assoc 1 d))
                         ";xdata=" (cdr (caddr x))) f)))
  (write-line (strcat "LAYER;" (vl-princ-to-string (entget (tblobjname "LAYER" "2") '("Eletron")))) f)
  (close f)
  (princ))
(princ)
